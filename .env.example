# ============================================================
# Wall Street CRM — environment config (committed template)
# Frontend-only mode: the browser calls Vapi's native REST API
# directly. Copy to .env and fill in your keys.
# ============================================================

# Browser reads this and calls api.vapi.ai directly.
VITE_VAPI_API_KEY=your_vapi_api_key_here

# Filter to this assistant so only Wall Street calls load.
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# (Optional) base URL override — defaults to https://api.vapi.ai
# VITE_VAPI_BASE_URL=https://api.vapi.ai
